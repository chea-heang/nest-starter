###############################################################################
#  NestJS — Development Dockerfile
#
#  • Starts with `nest start --watch` (ts-node + chokidar) for hot-reload.
#  • node_modules are installed inside the image layer; the host volume
#    is mounted OVER /app but node_modules is a named volume so it stays
#    Linux-native and is never overwritten by the host bind-mount.
###############################################################################

FROM node:22-alpine

# Install system deps needed by some native addons (bcrypt, etc.)
RUN apk add --no-cache python3 make g++ openssl

WORKDIR /app

# Copy only dependency manifests first — Docker layer cache:
# node_modules are only re-installed when package.json / lock file changes.
COPY package*.json ./

RUN npm install

# Copy source (will be overridden by bind-mount at runtime, but still
# needed if someone runs `docker build` without compose)
COPY . .

# Generate Prisma client from schema
RUN npx prisma generate

EXPOSE 3001

# ── Entrypoint: wait, migrate, then start with watch ──────────────────────────
# We use a tiny shell script so we can run migrations before the app starts.
CMD ["sh", "-c", "\
  echo '⏳ Waiting for Prisma migrate...' && \
  npx prisma migrate deploy && \
  echo '🚀 Starting NestJS in watch mode on port 3001...' && \
  PORT=3001 npm run start:dev \
"]

