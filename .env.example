# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_DATABASE=nest_db
MONGO_PORT=27017

# ─── Prisma Connection ─────────────────────────────────────────────────────────
# Local Docker MongoDB:
DATABASE_URL="mongodb://localhost:${MONGO_PORT}/${MONGO_DATABASE}?replicaSet=rs0&directConnection=true"

# MongoDB Atlas Free Tier (M0) format:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority"


# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── SMTP / Mailpit ─────────────────────────────────────────────────────────────
# Use "mailpit" if running inside Docker (default), or "localhost" if running NestJS directly on host
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Movie Platform <no-reply@movie-platform.local>"

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Caching ───────────────────────────────────────────────────────────────────
CACHE_DEFAULT_TTL=60
CACHE_MAX_ITEMS=500

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

