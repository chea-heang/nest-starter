# ─── Production Application Configuration ──────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Production MongoDB Configuration ──────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_password_minimum_16_chars
MONGO_INITDB_DATABASE=nest_db_prod
MONGO_PORT=27017

# In Docker network with Compose, host is "database":
DATABASE_URL="mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@database:27017/${MONGO_INITDB_DATABASE}?authSource=admin"

# Note: If connecting to MongoDB Atlas or managed external cluster:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/nest_db_prod?retryWrites=true&w=majority"

# ─── JWT Production Secrets (CRITICAL: Generate with: openssl rand -base64 32) ─
JWT_ACCESS_SECRET=replace_with_secure_random_base64_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_different_secure_random_base64_string_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Production SMTP Email ────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=replace_with_smtp_provider_api_key
SMTP_FROM="Movie Platform <notifications@yourdomain.com>"

# ─── Rate Limiting & Throttling ───────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── In-Memory Cache ──────────────────────────────────────────────────────────
CACHE_DEFAULT_TTL=60
CACHE_MAX_ITEMS=1000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Prisma Synchronization ───────────────────────────────────────────────────
# Set to true if you run schema synchronization out-of-band instead of at container startup
SKIP_MIGRATIONS=false
